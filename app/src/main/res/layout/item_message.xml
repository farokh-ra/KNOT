<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="2dp">

    <TextView
        android:id="@+id/textDateHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_date_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bubbleCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:id="@+id/replyBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:minWidth="140dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:id="@+id/replyAccent"
                        android:layout_width="3dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_reply_accent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textReplyAuthor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:minWidth="140dp"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textReplySnippet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxWidth="230dp"
                            android:maxLines="2"
                            android:textAppearance="?attr/textAppearanceBodySmall" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/textBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="280dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textIsSelectable="false"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/fileRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/imageFileIcon"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_file" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textFileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:maxWidth="220dp"
                            android:maxLines="2"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textFileInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:maxWidth="220dp"
                            android:textAppearance="?attr/textAppearanceLabelSmall" />

                        <ProgressBar
                            android:id="@+id/progressFile"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="220dp"
                            android:layout_height="4dp"
                            android:layout_marginTop="6dp"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="2dp"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceLabelSmall" />

                    <TextView
                        android:id="@+id/textTicks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</LinearLayout>
