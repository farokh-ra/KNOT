    <string name="about_title">درباره</string>
    <string name="about_hero_subtitle">دو دستگاه. یک رشته خصوصی.</string>
    <string name="about_version">نسخه %1$s · اندروید</string>
    <string name="about_made_by">طراحی و توسعه توسط</string>
    <string name="about_author">Farokh-Ra</string>
    <string name="about_author_role">توسعه‌دهنده نرم‌افزار · پروژه مستقل</string>
    <string name="about_links_title">پیوندهای پروژه</string>
    <string name="about_github">مخزن GitHub</string>
    <string name="about_github_value">github.com/farokh-ra/KNOT</string>
    <string name="about_telegram">تلگرام</string>
    <string name="about_telegram_value">@Farokhrex</string>
    <string name="about_features_title">Knot روی چه اصولی است</string>
    <string name="about_feature_direct_title">مستقیم به‌طور پیش‌فرض</string>
    <string name="about_feature_direct_body">اگر دو دستگاه نتوانند به هم برسند، Knot می‌گوید. هیچ رله‌ای پنهان در کار نیست.</string>
    <string name="about_feature_private_title">رمزنگاری سرتاسری</string>
    <string name="about_feature_private_body">توافق کلید X25519، HKDF-SHA256 و AES-256-GCM از هر پیام و بلوک فایل محافظت می‌کنند.</string>
    <string name="about_feature_serverless_title">بدون حساب، بدون سرور</string>
    <string name="about_feature_serverless_body">بدون تحلیل، ردیابی یا بک‌اند میزبانی‌شده. تاریخچه شما در محیط ایزوله برنامه است.</string>
    <string name="about_feature_files_title">فایل‌های هر اندازه</string>
    <string name="about_feature_files_body">در بلوک‌های رمزنگاری‌شده با پیشرفت، ادامه و بررسی خلاصه سرتاسری جریان می‌یابند.</string>
    <string name="about_privacy_title">ابزاری کوچک و صادق</string>
    <string name="about_privacy_body">Knot یک برنامه اندرویدی مستقل و آزمایشی است. شبکه همتاهبهمتا نمی‌تواند از هر NAT یا فایروالی عبور کند و دست‌دادن رمزنگاری‌شده هنوز بازبینی بیرونی نشده است. جایی استفاده کنید که هر دو طرف این محدودیت‌ها را بپذیرند.</string>
    <string name="about_open_source">کد منبع در GitHub است. مشارکت و گزارش تست شبکه خوش‌آمد است.</string>
    <string name="about_copyright">© ۲۰۲۶ Farokh-Ra. با دقت برای گفتگوهای خصوصی ساخته شده.</string>

