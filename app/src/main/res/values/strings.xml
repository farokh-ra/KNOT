    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_hero_subtitle">Two devices. One private thread.</string>
    <string name="about_version">Version %1$s · Android</string>
    <string name="about_made_by">Designed &amp; developed by</string>
    <string name="about_author">Farokh-Ra</string>
    <string name="about_author_role">Software developer · Independent project</string>
    <string name="about_links_title">Project links</string>
    <string name="about_github">GitHub repository</string>
    <string name="about_github_value">github.com/farokh-ra/KNOT</string>
    <string name="about_telegram">Telegram</string>
    <string name="about_telegram_value">@Farokhrex</string>
    <string name="about_features_title">What Knot stands for</string>
    <string name="about_feature_direct_title">Direct by design</string>
    <string name="about_feature_direct_body">If the two devices cannot reach each other, Knot says so. There is no relay hiding in the background.</string>
    <string name="about_feature_private_title">End-to-end encrypted</string>
    <string name="about_feature_private_body">X25519 key agreement, HKDF-SHA256 and AES-256-GCM protect every message and file block.</string>
    <string name="about_feature_serverless_title">No account, no server</string>
    <string name="about_feature_serverless_body">No analytics, no tracking and no hosted backend. Your history lives in the app sandbox.</string>
    <string name="about_feature_files_title">Files of any size</string>
    <string name="about_feature_files_body">Streamed in encrypted blocks with progress, resume and an end-to-end digest check.</string>
    <string name="about_privacy_title">A small, honest tool</string>
    <string name="about_privacy_body">Knot is an independent, experimental Android app. Direct peer-to-peer networking cannot cross every NAT or firewall, and the handshake has not been externally audited. Use it where both people understand those limits.</string>
    <string name="about_open_source">Source code is available on GitHub. Contributions and network-testing reports are welcome.</string>
    <string name="about_copyright">© 2026 Farokh-Ra. Built with care for private conversations.</string>

